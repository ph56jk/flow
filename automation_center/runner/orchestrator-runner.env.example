# Do not commit a real copy of this file.  It contains runner and Access secrets.
#
# File .env RIENG, khong dung chung voi content-image-runner hay listing2-erp-runner:
# ba runner khac AUTOMATION_RUNNER_KEY, dung chung mot file se khien runner nay
# heartbeat nham key va cuop viec cua runner kia.
AUTOMATION_CENTER_URL=https://automation.havigroup.llc
AUTOMATION_RUNNER_KEY=orchestrator-runner
AUTOMATION_RUNNER_LABEL=Agent dieu phoi (may trung tam)
AUTOMATION_RUNNER_SECRET=replace-with-the-same-value-as-Cloudflare-RUNNER_SHARED_SECRET
# A Cloudflare Access Service Token restricted to Automation HaviGroup.
# Dung lai duoc dung cap token cua content-image-runner.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Ban sao repo RIENG cho agent, KHONG tro vao C:\HaviGroup\flow-v2 dang chay
# service: agent checkout qua lai giua cac nhanh, tro vao ban dang chay se lam
# Flow doc code nua chung.
AGENT_REPO_DIR=C:\HaviGroup\agent-workspace\flow-v2
AGENT_BASE_BRANCH=main

# De trong (hoac 0) thi agent chi merge vao nhanh base o ban sao noi bo, khong
# day len remote.  Bat len chi khi da co nhanh bao ve tren remote.
AGENT_PUSH_REMOTE=0

# Lenh test chay sau moi thay doi.  Khong dat thi moi thay doi deu bi coi la
# "chua co test xanh" va khong bao gio tu ap dung duoc.
#
# Lenh chay voi cwd = AGENT_REPO_DIR, nen duong dan tuong doi kieu
# `.venv\Scripts\python.exe` tro vao ban sao cua agent -- cho do khong co venv.
# Dung duong dan tuyet doi toi trinh thong dich cua repo service: no da co du
# thu vien, va khong ton them ~1 GB dia cho mot venv thu hai.
AGENT_TEST_COMMAND=C:\HaviGroup\flow-v2\.venv\Scripts\python.exe -m unittest discover -s tests -q
AGENT_TEST_TIMEOUT_SECONDS=900

# Duong goi model.  auto = co OPENAI_API_KEY thi di HTTP, khong thi dung Codex
# CLI da dang nhap san tren may nay.  Dat thang "codex" de hong TO khi codex
# bien mat, thay vi am tham roi ve duong HTTP khong ai cau hinh.
AGENT_MODEL_PROVIDER=codex

# De trong thi tim "codex" trong PATH -- nhung Scheduled Task chay kieu S4U co
# PATH hep hon phien dang nhap, nen tro tuyet doi chac chan hon.
# make-orchestrator-env.ps1 tu do va ghi de gia tri nay.
CODEX_BIN=C:\Users\Admin\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe
# De trong thi dung model mac dinh cua codex.  Dung nhet OPENAI_MODEL vao day:
# ten model cua API va ten model cua codex khong cung mot bo.
CODEX_MODEL=

# Chi can khi AGENT_MODEL_PROVIDER=openai.  Voi duong codex thi de trong -- do
# chinh la ly do co duong codex: khong phai cat mot khoa API tren may trung tam.
# Neu co dien, khoa CHI nam o day: khong vao D1, public/, form cua Automation
# Center hay Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Dung chung cho ca hai duong: tran thoi gian cua mot luot hoi model.
OPENAI_TIMEOUT_SECONDS=300
