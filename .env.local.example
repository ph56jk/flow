# ─── Flow v2: setup 1 lần, các lần sau chỉ việc chạy ────────────────
#
# Copy file này thành ".env.local" trong cùng thư mục (root của repo)
# rồi điền giá trị thật. App tự load khi khởi động (flow_web/main.py
# gọi load_local_env() trong lifespan).
#
# Đây là cơ chế "bền vững" hơn data/state.json — kể cả khi state.json
# bị reset/xoá, các credentials trong .env.local vẫn được nhận diện
# qua fallback `os.getenv(...)` trong service.py.
#
# .env.local đã có trong .gitignore (dòng 4) nên không bị commit nhầm.
#
# ─── Nhật ký ─────────────────────────────────────────────────────────
# Mức log của app: DEBUG/INFO/WARNING/ERROR. Bỏ trống = INFO.
# Uvicorn chỉ tự ghi log của riêng nó, nên nếu không có dòng này thì mọi
# dòng của agent bot và các watcher không rơi vào file log nào cả — trên máy
# chạy nền 24/7 thì đó là mù hoàn toàn.
FLOW_LOG_LEVEL=
#
# ─── HaviGroup ERP (local-only fallback; prefer the app settings) ────
# Use a company API key + API secret. Never commit real values.
ERP_API_KEY=
ERP_API_SECRET=
ERP_BASE_URL=https://erp.havigroup.llc
# Flow v2 is deliberately restricted to this project.
ERP_PROJECT_ID=PROJ-0013
# Optional: source Task and source status (for example Open).
ERP_TASK_ID=
ERP_STATUS_ID=Open
# Tự động chạy các thẻ con chưa có ảnh của đúng thẻ Idea cha đang cấu hình.
# Chu kỳ quét (giây); 0 = tắt hẳn watcher. Bỏ trống = 180.
ERP_IDEA_AUTORUN_SECONDS=
# Số ảnh mỗi idea khi watcher tự chạy; bỏ trống/0 = dùng mặc định của app.
ERP_IDEA_AUTORUN_COUNT=
# Thẻ kẹt vì một lượt chạy hỏng dở được vá mỗi vòng quét: ảnh đã tạo mà chưa
# lên thẻ thì đăng bù (không tốn quota), ảnh chưa từng tạo thì chạy bù đúng
# phần thiếu. Đặt 0 để tắt riêng phần chạy bù.
ERP_IDEA_TOPUP=
# Job chạy xong tự đăng ảnh lên thẻ ERP để người duyệt bấm 👍/👎.
# Đặt 0 nếu muốn tự bấm "Đăng ảnh lên ERP để duyệt".
ERP_REVIEW_AUTOPUBLISH=

# ─── Agent bot ───────────────────────────────────────────────────────
# Thả một HVG Agent Bot vào thẻ ERP là xong: bot đọc 👍/👎 trên từng ảnh
# nó đã đăng (👎 = xoá khỏi thẻ, 👍 = giữ) và chạy thẻ Idea nào được gắn
# nó. Chỉ token là bắt buộc; bỏ trống token là tắt hẳn agent bot.
#
# Token bot phát bằng hvg_vault.api.issue_bot_token (không hết hạn, mỗi
# bot tối đa một token còn sống). Đây KHÔNG phải cặp ERP_API_KEY/SECRET
# ở trên: nó dùng lược đồ Authorization: HVGToken và chỉ mở đúng endpoint
# GraphQL.
ERP_AGENT_TOKEN=
# Tài khoản của bot, dạng agent-<tên>@bots.hvg.internal. Bỏ trống thì bot
# tự nhận ra chính mình, nhưng lượt dò đó phải ghi rồi xoá một bình luận
# kỹ thuật trên thẻ — điền vào là khỏi.
ERP_AGENT_BOT_USER=
# Các dự án agent được phép chạy, ngoài ERP_PROJECT_ID (luôn được tính kèm).
# Ngăn cách bằng dấu phẩy. Bỏ trống = mọi dự án ERP cho bot thấy, tức là thả
# bot vào dự án nào trên ERP là nó chạy ở đó, không phải sửa file này.
# Lưu ý: đây là chỗ thu hẹp, không phải chỗ cấp quyền — bot vẫn phải được
# thêm vào Project User của dự án thì ERP mới cho nó thấy. Để trống thì mọi
# board bot thấy đều chạy được, kể cả board vừa thêm bot vào hôm nay: Flow v2
# đọc phạm vi từ lượt quét gần nhất của bot chứ không từ file này.
ERP_AGENT_PROJECTS=
# Phạm vi nhận việc. Bỏ trống = "board": thêm bot vào dự án là đủ, bot tự
# chạy mọi thẻ Idea (thẻ còn mở và có thẻ con) của dự án đó. Đặt "card" nếu
# muốn bot chỉ chạy thẻ được gắn đích danh nó.
# Kể cả ở chế độ board, hễ trong một dự án có thẻ gắn bot thì dự án đó chỉ
# chạy đúng những thẻ ấy — đó là cách chỉ định "chỉ chạy thẻ này thôi".
ERP_AGENT_SCOPE=
# Cột nào trên board là lời giao việc. Ngăn cách bằng dấu phẩy. Bỏ trống = mọi
# cột chưa đóng, đúng như trước khi có dòng này.
# PROJ-0013 có Open / Working / Pending Review / Completed / Cancelled, và chủ
# dự án chọn **Working**: thẻ nằm ở Open là thẻ còn đang gõ dở — đó cũng là chỗ
# gõ `action_1: listing` vào trước khi ảnh xong — nên bot không đụng tới. Kéo
# thẻ sang Working chính là nút "chạy đi".
# So tên cột đã nén dấu nên gõ "working", "Working" hay tên cột tiếng Việt đều
# khớp; gõ sai hẳn thì log ghi rõ tên các cột đang thật sự có, chứ bot không
# lặng lẽ bỏ cả board.
# Hàng rào này CHỈ chặn phạm vi board. Thẻ được gắn đích danh bot vẫn chạy dù
# nằm ở cột nào — đó là lối cứu duy nhất cho thẻ lỡ gắn `action_1: listing`
# muộn, bịt nốt thì hết đường.
# Đây KHÔNG phải ERP_STATUS_ID ở trên: dòng kia nói app ghi thẻ vào cột nào,
# dòng này nói bot nhặt thẻ từ cột nào. Hai việc khác nhau, đừng gộp.
ERP_AGENT_SOURCE_STATUS=Working
# Số thẻ Idea được khởi động trong một lượt quét; mặc định 3. Cả app chỉ có
# một phiên Flow nên xếp cả board vào hàng không làm nhanh hơn. Phần dọn
# 👍/👎 không bị trần này chặn.
ERP_AGENT_MAX_CARDS_PER_SCAN=
# Chu kỳ quét (giây); 0 = tắt hẳn. Bỏ trống = 120.
# CHỈ MỘT MÁY được quét. Hai máy cùng token là hai máy cùng đọc 👍/👎 trên
# cùng một thẻ, mà 👎 thì xoá ảnh — không lấy lại được. Máy dự phòng phải đặt
# 0 ở đây; đặt ERP_AGENT_AUTORUN=0 thôi là chưa đủ, vì bot vẫn quét và vẫn
# dọn phiếu, chỉ không tạo ảnh.
ERP_AGENT_POLL_SECONDS=
# 0 nếu chỉ muốn bot dọn theo phiếu chứ không tự chạy tạo ảnh.
ERP_AGENT_AUTORUN=
# Khoảng cách tối thiểu giữa hai lần bot chạy lại cùng một thẻ; mặc định 900.
ERP_AGENT_AUTORUN_COOLDOWN_SECONDS=
# 1 = chạy khô: ghi log quyết định nhưng không xoá và không chạy gì.
ERP_AGENT_DRY_RUN=

# ─── Thẻ listing Etsy ───────────────────────────────────────────────
# Cùng một agent, hai loại thẻ. Thẻ nào viết `action_1: listing` trong khối
# *Thuộc tính* trên ERP là việc lên Etsy: nửa làm ảnh ở đây không đụng vào nó
# nữa mà giao sang bản Listing. Thẻ ảnh không viết `action_*` nào nên không
# hề bị ảnh hưởng.
#
# Bản Listing chỉ *đăng* bộ ảnh đã có 👍 trên chính thẻ đó: nó đọc thẻ, tải
# ảnh đính kèm, chép sang máy ảo Etsy và để extension dựng bản nháp. Không có
# lượt tạo ảnh thứ hai — nửa làm ảnh ở đây đã làm phần đó rồi.
#
# Bỏ trống ô dưới = tắt: bot vẫn nhận ra thẻ listing, vẫn không tự làm ảnh
# cho nó, nhưng không giao đi đâu cả (tổng kết ghi rõ "chưa cấu hình"). Đó là
# trạng thái đúng cho máy chưa dựng bản Listing.
#
# THỨ TỰ QUAN TRỌNG: viết `action_1: listing` vào thẻ TRƯỚC khi ảnh của nó
# xong. Dòng đó do người gõ, không nửa nào tự ghi, và bảng dự án ERP không trả
# khối *Thuộc tính* về — bot chỉ đọc được nó khi đã mở từng thẻ. Thẻ nào xong
# ảnh trước khi được gắn dòng ấy thì đã bị đóng sang cột kết thúc, và ở phạm vi
# board thẻ đã đóng không còn được đọc lại, nên dòng gắn muộn không ai thấy.
# Lỡ rồi thì cứu bằng cách gắn đích danh agent vào thẻ đó: thẻ có gắn bot được
# nhận không qua bước lọc cột.
ERP_LISTING_API_URL=
# Dự án ERP mà bản Listing đọc thẻ. Bỏ trống = dùng luôn ERP_PROJECT_ID ở
# trên, vì hai nửa đang nói về cùng một thẻ. Chỉ đổi khi bản Listing được ghim
# vào dự án khác.
ERP_LISTING_PROJECT=
# Trạng thái nguồn gửi kèm khi cần (bản Listing dùng để đoán template theo tên
# cột). Bỏ trống = để đầu kia tự đọc cột hiện tại của thẻ.
ERP_LISTING_STATUS=
# Đội máy Etsy mà bản Listing này phục vụ, cách nhau bằng dấu phẩy. Dùng để
# đổi `acc: acc32` trên thẻ thành tên máy thật theo quy ước số (acc32 →
# etsy-vn32). Số trùng nhau thì bỏ trống chứ không đoán.
ERP_LISTING_MACHINES=
# Máy nhận khi thẻ không nói gì. Trong đợt thử một máy, đây là máy duy nhất
# được phép nhận việc. Không có máy nào (thẻ không nói, ô này trống) thì thẻ
# bị từ chối chứ không gửi đại — gửi sai máy là ảnh lên nhầm shop.
ERP_LISTING_MACHINE=

# ─── Tốc độ chạy ảnh ────────────────────────────────────────────────
# Số thẻ idea chạy cùng lúc. Bỏ trống (hoặc "auto") = app tự tính theo CPU:
# mỗi thẻ 2 nhân, chừa 2 nhân cho Chrome và app, trần tự động 3. Đặt tay thì
# tối đa 4, đặt 1 để chạy lần lượt.
# Lưu ý: con số này KHÔNG làm tăng số ảnh đang được tạo cùng lúc — chỉ có một
# phiên Flow nên các thẻ vẫn xếp hàng trước panel Agent. Nó chia phần xóa
# watermark / mã hóa lại / upload ERP. Muốn tạo ảnh song song thật thì cần
# thêm profile Flow ở FLOW_CHROME_PROFILE_DIRS.
ERP_IDEA_CONCURRENCY=
# Giây chờ phản hồi batchGenerateImages trước khi quay sang đọc project.
# Ở chế độ Agent lần chờ này gần như luôn hết giờ rồi mới tìm thấy ảnh, nên
# đây là chỗ cắt bớt thời gian chết. Bỏ trống = 45, sàn 5, trần 120.
FLOW_AGENT_NETWORK_WAIT_SECONDS=
# Số lượt đúc lại token reCAPTCHA cho một lần nâng 2K. Token bị từ chối
# (HTTP 403 "reCAPTCHA evaluation failed") là lý do ảnh nằm lại ở 1024, và
# ảnh đã lỡ thì không nâng lại được. Bỏ trống = 3, tối đa 5.
FLOW_UPSAMPLE_RECAPTCHA_ROUNDS=

# ─── Remove Logo (xóa watermark Gemini trên ảnh Flow) ───────────────
# Server Node trong thư mục removelogo. Chạy `npm start` ở đó trước khi
# chạy job ảnh. Bỏ trống = dùng mặc định http://127.0.0.1:8788.
REMOVE_LOGO_URL=
# Đặt false nếu muốn tắt hẳn bước xóa watermark.
REMOVE_LOGO_ENABLED=

# ─── Google Gemini (Prompt Assistant) ───────────────────────────────
# Lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Multi-worker account mappings belong in .env.worker-3170.local or
# .env.worker-3171.local. Keep those files local and never commit them.
# FLOW_CHROME_PROFILE_DIRS=AccountA=data\workers\3170\flow-profiles\account-a
# FLOW_CHROME_PROFILE_PROJECTS=AccountA=your-google-flow-project-id
